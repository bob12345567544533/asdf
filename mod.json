{
	"geode": "5.11.2",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "lilwc.input-buffer",
	"name": "Input Buffer",
	"version": "v2.6.1",
	"developer": "lilWC",
	"description": "Input timing tweaks.",
	"tags": ["gameplay"],
	"settings": {
		"enabled": {
			"type": "bool",
			"name": "Enabled",
			"default": true
		},
		"buffer-ticks": {
			"type": "int",
			"name": "Ticks",
			"description": "1 tick = 4.17 ms at 240 TPS.",
			"default": 2,
			"min": 0,
			"max": 24,
			"control": { "arrow-step": 1, "slider-step": 1 }
		},
		"buffer-releases": {
			"type": "bool",
			"name": "Releases",
			"description": "Wave, ship and robot.",
			"default": true
		},
		"buffer-ship": {
			"type": "bool",
			"name": "Ship",
			"default": false
		},
		"ship-assist": {
			"type": "int",
			"name": "Ship Assist (%)",
			"description": "Makes the ship a bit floatier. 0 = off.",
			"default": 15,
			"min": 0,
			"max": 50,
			"control": { "arrow-step": 1, "slider-step": 1 }
		},
		"ufo-assist": {
			"type": "int",
			"name": "UFO Assist (%)",
			"description": "Makes the UFO a bit floatier. 0 = off.",
			"default": 0,
			"min": 0,
			"max": 50,
			"control": { "arrow-step": 1, "slider-step": 1 }
		},
		"robot-assist": {
			"type": "int",
			"name": "Robot Assist (%)",
			"description": "Makes the robot a bit floatier. 0 = off.",
			"default": 0,
			"min": 0,
			"max": 50,
			"control": { "arrow-step": 1, "slider-step": 1 }
		},
		"ledge-grace": {
			"type": "int",
			"name": "Ledge Grace (ticks)",
			"description": "Lets you still jump for a few ticks after running off a block. 0 = off.",
			"default": 0,
			"min": 0,
			"max": 12,
			"control": { "arrow-step": 1, "slider-step": 1 }
		},
		"late-orbs": {
			"type": "int",
			"name": "Late Orbs (ticks)",
			"description": "Orbs still activate if you click a few ticks after passing them. 0 = off.",
			"default": 0,
			"min": 0,
			"max": 12,
			"control": { "arrow-step": 1, "slider-step": 1 }
		},
		"hitbox-shrink": {
			"type": "int",
			"name": "Hitbox Forgiveness (%)",
			"description": "Spikes that only graze the edge of your hitbox don't kill you. 0 = off.",
			"default": 0,
			"min": 0,
			"max": 50,
			"control": { "arrow-step": 1, "slider-step": 1 }
		},
		"wave-assist": {
			"type": "int",
			"name": "Wave Assist (px)",
			"description": "Nudges the wave up to this many pixels away from corners it's about to clip. 0 = off.",
			"default": 0,
			"min": 0,
			"max": 10,
			"control": { "arrow-step": 1, "slider-step": 1 }
		},
		"danger-slowmo": {
			"type": "int",
			"name": "Danger Slow-Mo (%)",
			"description": "Slows the game down this much right before you'd die. 0 = off.",
			"default": 0,
			"min": 0,
			"max": 50,
			"control": { "arrow-step": 1, "slider-step": 1 }
		},
		"toggle-key": {
			"type": "keybind",
			"name": "Toggle Key",
			"default": "F6",
			"category": "gameplay"
		},
		"menu-key": {
			"type": "keybind",
			"name": "Window Key",
			"default": "F7",
			"category": "universal"
		},
		"open-window": {
			"type": "bool",
			"name": "Open Window On Launch",
			"default": true
		},
		"window-size": {
			"type": "int",
			"name": "Window Size (%)",
			"description": "On top of the automatic sizing (1x on 1080p, 1.33x on 1440p).",
			"default": 100,
			"min": 50,
			"max": 200,
			"control": { "arrow-step": 5, "slider-step": 5 }
		},
		"display-title": {
			"type": "title",
			"name": "Display"
		},
		"show-feedback": {
			"type": "bool",
			"name": "Timing Popup",
			"default": true
		},
		"show-stats": {
			"type": "bool",
			"name": "Counter",
			"default": false
		},
		"label-position": {
			"type": "string",
			"name": "Text Position",
			"default": "Bottom Left",
			"one-of": ["Top Left", "Top Right", "Bottom Left", "Bottom Right"]
		},
		"label-scale": {
			"type": "float",
			"name": "Text Size",
			"default": 0.4,
			"min": 0.2,
			"max": 1.0,
			"control": { "arrow-step": 0.05, "slider-step": 0.05 }
		},
		"label-opacity": {
			"type": "int",
			"name": "Text Opacity",
			"default": 200,
			"min": 20,
			"max": 255,
			"control": { "arrow-step": 5, "slider-step": 5 }
		},
		"advanced-title": {
			"type": "title",
			"name": "Advanced"
		},
		"look-ahead-ms": {
			"type": "float",
			"name": "Look-Ahead (ms)",
			"default": 200,
			"min": 50,
			"max": 400,
			"control": { "arrow-step": 10, "slider-step": 10 }
		},
		"wave-look-ahead-ms": {
			"type": "float",
			"name": "Wave Look-Ahead (ms)",
			"default": 160,
			"min": 50,
			"max": 400,
			"control": { "arrow-step": 10, "slider-step": 10 }
		},
		"min-gain-ms": {
			"type": "float",
			"name": "Min Gain (ms)",
			"default": 45,
			"min": 5,
			"max": 200,
			"control": { "arrow-step": 5, "slider-step": 5 }
		},
		"debug-log": {
			"type": "bool",
			"name": "Debug Logging",
			"default": false
		}
	}
}
