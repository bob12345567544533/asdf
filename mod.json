{
	"geode": "5.11.2",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "lilwc.input-buffer-lite",
	"name": "Input Buffer Lite",
	"version": "v1.3.1",
	"developer": "lilWC",
	"description": "Input timing tweaks.",
	"tags": ["gameplay"],
	"settings": {
		"enabled": {
			"type": "bool",
			"name": "Enabled",
			"default": true
		},
		"buffer-ticks": {
			"type": "int",
			"name": "Max Ticks",
			"description": "1 tick = 4.17 ms at 240 TPS.",
			"default": 2,
			"min": 0,
			"max": 24,
			"control": { "arrow-step": 1, "slider-step": 1 }
		},
		"buffer-min-ticks": {
			"type": "int",
			"name": "Min Ticks",
			"description": "Smallest delay the buffer will use. With Min 1 and Ticks 4 it only delays by 1 to 4 ticks.",
			"default": 1,
			"min": 1,
			"max": 24,
			"control": { "arrow-step": 1, "slider-step": 1 }
		},
		"randomize": {
			"type": "int",
			"name": "Randomize (ticks)",
			"description": "0 = always use the smallest safe delay (plus 1 tick margin). Above 0 = pick a random safe delay up to this many ticks above the smallest one.",
			"default": 0,
			"min": 0,
			"max": 24,
			"control": { "arrow-step": 1, "slider-step": 1 }
		},
		"buffer-releases": {
			"type": "bool",
			"name": "Releases",
			"description": "Wave, ship and robot.",
			"default": true
		},
		"buffer-ship": {
			"type": "bool",
			"name": "Ship",
			"default": false
		},
		"toggle-key": {
			"type": "keybind",
			"name": "Toggle Key",
			"default": "F6",
			"category": "gameplay"
		},
		"menu-key": {
			"type": "keybind",
			"name": "Window Key",
			"default": "F7",
			"category": "universal"
		},
		"open-window": {
			"type": "bool",
			"name": "Open Window On Launch",
			"default": true
		},
		"window-size": {
			"type": "int",
			"name": "Window Size (%)",
			"description": "On top of the automatic sizing (1x on 1080p, 1.33x on 1440p).",
			"default": 100,
			"min": 50,
			"max": 200,
			"control": { "arrow-step": 5, "slider-step": 5 }
		},
		"display-title": {
			"type": "title",
			"name": "Display"
		},
		"show-feedback": {
			"type": "bool",
			"name": "Timing Popup",
			"default": true
		},
		"label-position": {
			"type": "string",
			"name": "Text Position",
			"default": "Bottom Left",
			"one-of": ["Top Left", "Top Right", "Bottom Left", "Bottom Right"]
		},
		"label-scale": {
			"type": "float",
			"name": "Text Size",
			"default": 0.4,
			"min": 0.2,
			"max": 1.0,
			"control": { "arrow-step": 0.05, "slider-step": 0.05 }
		},
		"label-opacity": {
			"type": "int",
			"name": "Text Opacity",
			"default": 200,
			"min": 20,
			"max": 255,
			"control": { "arrow-step": 5, "slider-step": 5 }
		},
		"advanced-title": {
			"type": "title",
			"name": "Advanced"
		},
		"look-ahead-ms": {
			"type": "float",
			"name": "Look-Ahead (ms)",
			"default": 200,
			"min": 50,
			"max": 400,
			"control": { "arrow-step": 10, "slider-step": 10 }
		},
		"wave-look-ahead-ms": {
			"type": "float",
			"name": "Wave Look-Ahead (ms)",
			"default": 160,
			"min": 50,
			"max": 400,
			"control": { "arrow-step": 10, "slider-step": 10 }
		},
		"min-gain-ms": {
			"type": "float",
			"name": "Min Gain (ms)",
			"default": 45,
			"min": 5,
			"max": 200,
			"control": { "arrow-step": 5, "slider-step": 5 }
		},
		"debug-log": {
			"type": "bool",
			"name": "Debug Logging",
			"default": false
		}
	}
}
